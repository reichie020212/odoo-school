<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_attendance_list" model="ir.ui.view">
        <field name="name">school.attendance.list</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="session_id"/>
                <field name="course_id" readonly="1"/>
                <field name="student_id"/>
                <field name="state" widget="badge"
                       decoration-success="state=='present'"
                       decoration-danger="state=='absent'"
                       decoration-warning="state=='late'"
                       decoration-info="state=='excused'"/>
                <field name="note"/>
                <field name="recorded_by_id" optional="hide"/>
                <field name="recorded_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_school_attendance_form" model="ir.ui.view">
        <field name="name">school.attendance.form</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="session_id"/>
                            <field name="course_id" readonly="1"/>
                            <field name="student_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="recorded_by_id"/>
                            <field name="recorded_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_attendance_search" model="ir.ui.view">
        <field name="name">school.attendance.search</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="session_id"/>
                <filter name="present" string="Present" domain="[('state', '=', 'present')]"/>
                <filter name="absent" string="Absent" domain="[('state', '=', 'absent')]"/>
                <filter name="late" string="Late" domain="[('state', '=', 'late')]"/>
                <filter name="excused" string="Excused" domain="[('state', '=', 'excused')]"/>
                <group>
                    <filter name="group_course" string="Course" context="{'group_by': 'course_id'}"/>
                    <filter name="group_student" string="Student" context="{'group_by': 'student_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">school.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_attendance_search"/>
    </record>

</odoo>
