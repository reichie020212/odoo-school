<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_school_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">school.course</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_school_course_list" model="ir.ui.view">
        <field name="name">school.course.list</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <list decoration-muted="state=='closed'" decoration-info="state=='open'">
                <field name="name"/>
                <field name="subject_id"/>
                <field name="classroom_id"/>
                <field name="term_id"/>
                <field name="teacher_id"/>
                <field name="student_count"/>
                <field name="session_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_school_course_kanban" model="ir.ui.view">
        <field name="name">school.course.kanban</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" highlight_color="color">
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <strong><field name="name"/></strong>
                            <div><field name="teacher_id"/></div>
                            <div><field name="classroom_id"/> · <field name="term_id"/></div>
                            <div>
                                <span class="badge text-bg-primary"><field name="student_count"/> students</span>
                                <span class="badge text-bg-secondary ms-1"><field name="session_count"/> sessions</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_school_course_form" model="ir.ui.view">
        <field name="name">school.course.form</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" type="object" string="Open"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'open'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <button name="action_materialize_sessions" type="object"
                            string="Generate Sessions" class="btn-secondary"
                            invisible="state == 'closed'"/>
                    <button name="action_reset_enrollment" type="object"
                            string="Re-sync Roster" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_sessions" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="session_count" widget="statinfo" string="Sessions"/>
                        </button>
                        <button name="action_open_attendance" type="object"
                                class="oe_stat_button" icon="fa-check-square-o">
                            <field name="student_count" widget="statinfo" string="Students"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Auto-generated from subject / classroom / term"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="subject_id"/>
                            <field name="classroom_id"/>
                            <field name="teacher_id"/>
                        </group>
                        <group>
                            <field name="term_id"/>
                            <field name="academic_year_id" readonly="1"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Students" name="students">
                            <field name="student_ids" context="{'default_is_student': True}">
                                <list>
                                    <field name="student_admission_number"/>
                                    <field name="name"/>
                                    <field name="student_classroom_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Weekly Schedule" name="schedule">
                            <field name="schedule_rule_ids">
                                <list editable="bottom">
                                    <field name="weekday"/>
                                    <field name="time_start" widget="float_time"/>
                                    <field name="duration" widget="float_time"/>
                                    <field name="location"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sessions" name="sessions">
                            <field name="session_ids" readonly="1">
                                <list>
                                    <field name="start"/>
                                    <field name="stop"/>
                                    <field name="location"/>
                                    <field name="school_session_state" widget="badge"/>
                                    <field name="school_attendance_count" string="Attendance"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_course_search" model="ir.ui.view">
        <field name="name">school.course.search</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subject_id"/>
                <field name="classroom_id"/>
                <field name="teacher_id"/>
                <field name="term_id"/>
                <filter name="state_open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="state_closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <group>
                    <filter name="group_term" string="Term" context="{'group_by': 'term_id'}"/>
                    <filter name="group_subject" string="Subject" context="{'group_by': 'subject_id'}"/>
                    <filter name="group_classroom" string="Classroom" context="{'group_by': 'classroom_id'}"/>
                    <filter name="group_teacher" string="Teacher" context="{'group_by': 'teacher_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_course" model="ir.actions.act_window">
        <field name="search_view_id" ref="view_school_course_search"/>
    </record>

</odoo>
