<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Student admission number sequence.
            Editable from UI under School → Configuration → Admission Number Sequence.
            Default format: year-prefixed, e.g. "2026-00001".
        -->
        <record id="seq_student_admission" model="ir.sequence">
            <field name="name">Student Admission Number</field>
            <field name="code">school.student.admission</field>
            <field name="prefix">%(range_year)s-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
            <field name="implementation">standard</field>
        </record>

    </data>
</odoo>
