<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Non-admin demo users so testers and viewers can sign in without
            needing the all-powerful admin account.

            Login + password follow the `demo_<role>` pattern; for multiple
            accounts of the same role suffix `_2`, `_3`, etc. (e.g. a second
            demo student would be `demo_student_2`).

            Logins double as passwords for convenience in demo / tester
            environments — never enable demo data in production.

            Two flavours:

            * Generic backend roles — `demo_user` and `demo_reader`. Not
              tied to a specific persona; use them to exercise plain
              School User / School Reader access.

            * Persona accounts — `demo_student` (Alice), `demo_guardian`
              (Carlos), `demo_teacher` (Maria), `demo_registrar`. Wired
              to the matching demo partner / employee where ACLs care
              (student & guardian must own their portal records via
              `partner_id`).

            * `demo_admin` — admin-equivalent for showcasing the system
              without handing over the keys. Holds School Manager (full
              school CRUD) and Contact Creation (manage partners), but
              deliberately omits both `base.group_system` AND
              `base.group_erp_manager`. The Settings menu
              (`base.menu_administration`) is gated by exactly those
              two groups in Odoo 19; granting either one would put the
              Apps install / Technical / Users-&-Companies submenus
              back in reach. The `_erp_manager` removal is the load-
              bearing one — it transitively pulls in "Technical
              Features" and is the group most-often-mistaken-for-safe.
        -->

        <!-- Generic backend roles -->

        <record id="demo_school_user" model="res.users">
            <field name="name">Demo School User</field>
            <field name="login">demo_user</field>
            <field name="password">demo_user</field>
            <field name="email">demo_user@example.com</field>
            <field name="group_ids"
                   eval="[(6, 0, [ref('base.group_user'), ref('school_base.group_school_user')])]"/>
        </record>

        <record id="demo_school_reader" model="res.users">
            <field name="name">Demo School Reader</field>
            <field name="login">demo_reader</field>
            <field name="password">demo_reader</field>
            <field name="email">demo_reader@example.com</field>
            <field name="group_ids"
                   eval="[(6, 0, [ref('base.group_user'), ref('school_base.group_school_reader')])]"/>
        </record>

        <!-- Personas: student & guardian (portal users) -->

        <record id="demo_user_student_alice" model="res.users">
            <field name="login">demo_student</field>
            <field name="password">demo_student</field>
            <field name="partner_id" ref="student_alice_garcia"/>
            <field name="group_ids" eval="[(6, 0, [ref('base.group_portal')])]"/>
        </record>

        <record id="demo_user_guardian_carlos" model="res.users">
            <field name="login">demo_guardian</field>
            <field name="password">demo_guardian</field>
            <field name="partner_id" ref="guardian_carlos_garcia"/>
            <field name="group_ids" eval="[(6, 0, [ref('base.group_portal')])]"/>
        </record>

        <!-- Personas: teacher & registrar (internal users) -->

        <record id="demo_user_teacher_maria" model="res.users">
            <field name="name">Maria Santos</field>
            <field name="login">demo_teacher</field>
            <field name="password">demo_teacher</field>
            <field name="email">demo_teacher@example.com</field>
            <field name="group_ids"
                   eval="[(6, 0, [ref('base.group_user'), ref('school_base.group_school_user')])]"/>
        </record>

        <record id="demo_user_registrar" model="res.users">
            <field name="name">School Registrar</field>
            <field name="login">demo_registrar</field>
            <field name="password">demo_registrar</field>
            <field name="email">demo_registrar@example.com</field>
            <field name="group_ids"
                   eval="[(6, 0, [ref('base.group_user'), ref('school_base.group_school_manager')])]"/>
        </record>

        <!-- Admin-equivalent without sysadmin powers -->

        <record id="demo_user_admin" model="res.users">
            <field name="name">Demo Admin</field>
            <field name="login">demo_admin</field>
            <field name="password">demo_admin</field>
            <field name="email">demo_admin@example.com</field>
            <field name="group_ids"
                   eval="[(6, 0, [
                       ref('base.group_user'),
                       ref('base.group_partner_manager'),
                       ref('school_base.group_school_manager'),
                   ])]"/>
        </record>

    </data>
</odoo>
