<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Privilege (Odoo 19 — replaces ir.module.category on groups) -->
        <record id="privilege_school_management" model="res.groups.privilege">
            <field name="name">School Management</field>
            <field name="sequence">10</field>
        </record>

        <!-- Groups -->
        <record id="group_school_reader" model="res.groups">
            <field name="name">Reader</field>
            <field name="privilege_id" ref="privilege_school_management"/>
            <field name="comment">Read-only access to school records.</field>
        </record>

        <record id="group_school_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_school_management"/>
            <field name="implied_ids" eval="[(4, ref('group_school_reader'))]"/>
            <field name="comment">Day-to-day school operations: manage students, classrooms, terms.</field>
        </record>

        <record id="group_school_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_school_management"/>
            <field name="implied_ids" eval="[(4, ref('group_school_user'))]"/>
            <field name="comment">Full control of school configuration including academic year lifecycle.</field>
        </record>

    </data>
</odoo>
