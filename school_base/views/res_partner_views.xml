<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit the partner form: add School Information + Guardians pages -->
    <record id="view_res_partner_form_school" model="ir.ui.view">
        <field name="name">res.partner.form.school</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="before">
                <group>
                    <group>
                        <field name="is_student"/>
                        <field name="is_guardian"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Student Information" name="school_student_info"
                      invisible="not is_student">
                    <group>
                        <group>
                            <field name="student_admission_number" readonly="1"/>
                            <field name="student_admission_date"/>
                            <field name="student_status"/>
                            <field name="student_classroom_id"
                                   domain="[('academic_year_id.state', '!=', 'archived')]"/>
                            <field name="student_academic_year_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="student_date_of_birth"/>
                            <field name="student_gender"/>
                            <field name="student_blood_type"/>
                            <field name="student_emergency_contact_name"/>
                            <field name="student_emergency_contact_phone"/>
                        </group>
                    </group>
                    <group string="Medical Notes">
                        <field name="student_medical_notes" nolabel="1"/>
                    </group>
                </page>
                <page string="Guardians" name="school_guardians" invisible="not is_student">
                    <field name="student_guardian_ids">
                        <list>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </list>
                    </field>
                </page>
                <page string="Wards" name="school_wards" invisible="not is_guardian">
                    <field name="student_ward_ids">
                        <list>
                            <field name="student_admission_number"/>
                            <field name="name"/>
                            <field name="student_classroom_id"/>
                            <field name="student_status"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Dedicated list for students -->
    <record id="view_res_partner_student_list" model="ir.ui.view">
        <field name="name">res.partner.student.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_admission_number"/>
                <field name="name"/>
                <field name="student_gender"/>
                <field name="student_date_of_birth"/>
                <field name="student_classroom_id"/>
                <field name="student_academic_year_id"/>
                <field name="student_status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_res_partner_student_search" model="ir.ui.view">
        <field name="name">res.partner.student.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Student"/>
                <field name="student_admission_number"/>
                <field name="student_classroom_id"/>
                <field name="student_academic_year_id"/>
                <filter name="enrolled" string="Enrolled"
                        domain="[('student_status', '=', 'enrolled')]"/>
                <filter name="on_leave" string="On Leave"
                        domain="[('student_status', '=', 'on_leave')]"/>
                <filter name="graduated" string="Graduated"
                        domain="[('student_status', '=', 'graduated')]"/>
                <group>
                    <filter name="group_classroom" string="Classroom"
                            context="{'group_by': 'student_classroom_id'}"/>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'student_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_students" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_student', '=', True)]</field>
        <field name="context">{'default_is_student': True}</field>
        <field name="search_view_id" ref="view_res_partner_student_search"/>
    </record>

    <!-- Dedicated list for guardians -->
    <record id="view_res_partner_guardian_list" model="ir.ui.view">
        <field name="name">res.partner.guardian.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="student_ward_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="action_school_guardians" model="ir.actions.act_window">
        <field name="name">Guardians</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_guardian', '=', True)]</field>
        <field name="context">{'default_is_guardian': True}</field>
    </record>

</odoo>
