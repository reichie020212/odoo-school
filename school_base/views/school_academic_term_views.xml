<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_academic_term_list" model="ir.ui.view">
        <field name="name">school.academic.term.list</field>
        <field name="model">school.academic.term</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="academic_year_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>

    <record id="view_school_academic_term_form" model="ir.ui.view">
        <field name="name">school.academic.term.form</field>
        <field name="model">school.academic.term</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. First Semester"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="academic_year_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_academic_term_search" model="ir.ui.view">
        <field name="name">school.academic.term.search</field>
        <field name="model">school.academic.term</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="academic_year_id"/>
                <group>
                    <filter name="group_year" string="Academic Year"
                            context="{'group_by': 'academic_year_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_academic_term" model="ir.actions.act_window">
        <field name="name">Academic Terms</field>
        <field name="res_model">school.academic.term</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_academic_term_search"/>
    </record>

</odoo>
