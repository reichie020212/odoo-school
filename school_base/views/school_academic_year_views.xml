<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_academic_year_list" model="ir.ui.view">
        <field name="name">school.academic.year.list</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='active'" decoration-muted="state=='archived'">
                <field name="code"/>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="term_count"/>
                <field name="classroom_count"/>
                <field name="state" widget="badge"
                       decoration-info="state=='active'"
                       decoration-muted="state=='archived'"/>
                <field name="is_current" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_school_academic_year_form" model="ir.ui.view">
        <field name="name">school.academic.year.form</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="oe_highlight" invisible="state == 'active'"/>
                    <button name="action_archive_year" type="object" string="Archive"
                            invisible="state == 'archived'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. 2026–2027"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. AY2627"/>
                            <field name="is_current"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Terms" name="terms">
                            <field name="term_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                </list>
                            </field>
                        </page>
                        <page string="Classrooms" name="classrooms">
                            <field name="classroom_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="grade_level"/>
                                    <field name="section"/>
                                    <field name="capacity"/>
                                    <field name="student_count"/>
                                    <field name="homeroom_teacher_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_academic_year_search" model="ir.ui.view">
        <field name="name">school.academic.year.search</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="current" string="Current" domain="[('is_current', '=', True)]"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="archived" string="Archived" domain="[('state', '=', 'archived')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_academic_year" model="ir.actions.act_window">
        <field name="name">Academic Years</field>
        <field name="res_model">school.academic.year</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_academic_year_search"/>
    </record>

</odoo>
