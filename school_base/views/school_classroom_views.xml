<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Actions are declared first because the form's stat button
         references action_school_classroom_students via %()d. -->

    <record id="action_school_classroom" model="ir.actions.act_window">
        <field name="name">Classrooms</field>
        <field name="res_model">school.classroom</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_school_classroom_students" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_student', '=', True), ('student_classroom_id', '=', active_id)]</field>
        <field name="context">{'default_is_student': True, 'default_student_classroom_id': active_id}</field>
    </record>

    <record id="view_school_classroom_list" model="ir.ui.view">
        <field name="name">school.classroom.list</field>
        <field name="model">school.classroom</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="grade_level"/>
                <field name="section"/>
                <field name="academic_year_id"/>
                <field name="homeroom_teacher_id"/>
                <field name="student_count"/>
                <field name="capacity"/>
            </list>
        </field>
    </record>

    <record id="view_school_classroom_form" model="ir.ui.view">
        <field name="name">school.classroom.form</field>
        <field name="model">school.classroom</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_school_classroom_students)d"
                                type="action" class="oe_stat_button" icon="fa-graduation-cap">
                            <field name="student_count" widget="statinfo" string="Students"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Grade 10 — A"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="grade_level"/>
                            <field name="section"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="academic_year_id"/>
                            <field name="homeroom_teacher_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Students" name="students">
                            <field name="student_ids"
                                   context="{'default_is_student': True, 'default_student_classroom_id': id}">
                                <list>
                                    <field name="student_admission_number"/>
                                    <field name="name"/>
                                    <field name="student_gender"/>
                                    <field name="student_status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_classroom_search" model="ir.ui.view">
        <field name="name">school.classroom.search</field>
        <field name="model">school.classroom</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="academic_year_id"/>
                <field name="homeroom_teacher_id"/>
                <filter name="current_year" string="Current Year"
                        domain="[('academic_year_id.is_current', '=', True)]"/>
                <group>
                    <filter name="group_year" string="Academic Year"
                            context="{'group_by': 'academic_year_id'}"/>
                    <filter name="group_grade" string="Grade Level"
                            context="{'group_by': 'grade_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Bind the search view to the classrooms action after the view exists. -->
    <record id="action_school_classroom" model="ir.actions.act_window">
        <field name="search_view_id" ref="view_school_classroom_search"/>
    </record>

</odoo>
