<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_partner_form_canteen" model="ir.ui.view">
        <field name="name">res.partner.form.canteen</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="school_base.view_res_partner_form_school"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='school_student_info']//field[@name='student_medical_notes']" position="before">
                <field name="canteen_allergy_tag_ids"
                       widget="many2many_tags"
                       options="{'color_field': 'color'}"/>
            </xpath>
        </field>
    </record>

</odoo>
