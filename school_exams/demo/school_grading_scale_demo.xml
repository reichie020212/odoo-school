<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="scale_us" model="school.grading.scale">
            <field name="name">US Standard (A–F)</field>
            <field name="code">US</field>
            <field name="is_default" eval="True"/>
        </record>

        <record id="scale_us_band_a" model="school.grading.scale.band">
            <field name="scale_id" ref="scale_us"/>
            <field name="sequence">10</field>
            <field name="letter">A</field>
            <field name="min_percentage">90.0</field>
            <field name="gpa_value">4.0</field>
        </record>
        <record id="scale_us_band_b" model="school.grading.scale.band">
            <field name="scale_id" ref="scale_us"/>
            <field name="sequence">20</field>
            <field name="letter">B</field>
            <field name="min_percentage">80.0</field>
            <field name="gpa_value">3.0</field>
        </record>
        <record id="scale_us_band_c" model="school.grading.scale.band">
            <field name="scale_id" ref="scale_us"/>
            <field name="sequence">30</field>
            <field name="letter">C</field>
            <field name="min_percentage">70.0</field>
            <field name="gpa_value">2.0</field>
        </record>
        <record id="scale_us_band_d" model="school.grading.scale.band">
            <field name="scale_id" ref="scale_us"/>
            <field name="sequence">40</field>
            <field name="letter">D</field>
            <field name="min_percentage">60.0</field>
            <field name="gpa_value">1.0</field>
        </record>
        <record id="scale_us_band_f" model="school.grading.scale.band">
            <field name="scale_id" ref="scale_us"/>
            <field name="sequence">50</field>
            <field name="letter">F</field>
            <field name="min_percentage">0.0</field>
            <field name="gpa_value">0.0</field>
        </record>

        <!-- Philippine DepEd-style scale (representative). -->
