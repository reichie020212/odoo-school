<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_school_report_card">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>

                        <h2 class="mt-3">Report Card</h2>
                        <h4 t-out="doc.name" class="text-muted"/>

                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Student</strong>
                                <div t-out="doc.student_id.display_name"/>
                                <div t-if="doc.student_id.student_admission_number">
                                    Admission #: <span t-out="doc.student_id.student_admission_number"/>
                                </div>
                                <div t-if="doc.student_id.student_classroom_id">
                                    Classroom: <span t-out="doc.student_id.student_classroom_id.name"/>
                                </div>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Academic Year</strong>
                                <div t-out="doc.academic_year_id.name"/>
                                <strong>Term</strong>
                                <div t-out="doc.term_id.name"/>
                                <strong>Issue Date</strong>
                                <div t-out="doc.issue_date" t-options="{'widget': 'date'}"/>
                            </div>
                        </div>

                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>Subject</th>
                                    <th>Teacher</th>
                                    <th class="text-center">%</th>
                                    <th class="text-center">Letter</th>
                                    <th class="text-center">GPA</th>
                                    <th>Remark</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td t-out="line.subject_id.name"/>
                                    <td t-out="line.teacher_id.name"/>
                                    <td class="text-center">
                                        <span t-if="not line.is_incomplete"
                                              t-out="line.percentage"
                                              t-options="{'widget': 'float', 'precision': 2}"/>
                                        <span t-if="line.is_incomplete" class="text-muted">Incomplete</span>
                                    </td>
                                    <td class="text-center" t-out="line.letter_grade"/>
                                    <td class="text-center" t-out="line.gpa_value" t-options="{'widget': 'float', 'precision': 2}"/>
                                    <td t-out="line.teacher_remark"/>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="2" class="text-end">Overall</td>
                                    <td class="text-center" t-out="doc.overall_percentage" t-options="{'widget': 'float', 'precision': 2}"/>
                                    <td class="text-center" t-out="doc.overall_letter"/>
                                    <td class="text-center" t-out="doc.overall_gpa" t-options="{'widget': 'float', 'precision': 2}"/>
                                    <td/>
                                </tr>
                            </tfoot>
                        </table>

                        <div t-if="doc.teacher_remark" class="mt-4">
                            <strong>Overall Remark</strong>
                            <p t-out="doc.teacher_remark"/>
                        </div>

                        <div class="row mt-5">
                            <div class="col-6">
                                <div class="border-top pt-2" style="width: 70%;">
                                    Homeroom Teacher
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="border-top pt-2" style="width: 70%;">
                                    Principal
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
