<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_exam_result_list" model="ir.ui.view">
        <field name="name">school.exam.result.list</field>
        <field name="model">school.exam.result</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="exam_id"/>
                <field name="course_id" readonly="1"/>
                <field name="student_id"/>
                <field name="score"/>
                <field name="max_score" readonly="1"/>
                <field name="percentage" readonly="1"/>
                <field name="letter_grade" readonly="1"/>
                <field name="remark"/>
            </list>
        </field>
    </record>

    <record id="view_school_exam_result_search" model="ir.ui.view">
        <field name="name">school.exam.result.search</field>
        <field name="model">school.exam.result</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="exam_id"/>
                <field name="course_id"/>
                <group>
                    <filter name="group_course" string="Course" context="{'group_by': 'course_id'}"/>
                    <filter name="group_student" string="Student" context="{'group_by': 'student_id'}"/>
                    <filter name="group_exam" string="Exam" context="{'group_by': 'exam_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_exam_result" model="ir.actions.act_window">
        <field name="name">Exam Results</field>
        <field name="res_model">school.exam.result</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_school_exam_result_search"/>
    </record>

</odoo>
