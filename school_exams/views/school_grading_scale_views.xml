<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_grading_scale_list" model="ir.ui.view">
        <field name="name">school.grading.scale.list</field>
        <field name="model">school.grading.scale</field>
        <field name="arch" type="xml">
            <list decoration-info="is_default">
                <field name="code"/>
                <field name="name"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_school_grading_scale_form" model="ir.ui.view">
        <field name="name">school.grading.scale.form</field>
        <field name="model">school.grading.scale</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Default" invisible="not is_default"/>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. US Standard"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="US"/>
                            <field name="is_default"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Bands">
                        <field name="band_ids" nolabel="1" colspan="4">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="letter"/>
                                <field name="min_percentage"/>
                                <field name="gpa_value"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_grading_scale" model="ir.actions.act_window">
        <field name="name">Grading Scales</field>
        <field name="res_model">school.grading.scale</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
