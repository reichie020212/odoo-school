<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="product_tuition" model="product.product">
            <field name="name">Tuition Fee</field>
            <field name="default_code">FEE-TUITION</field>
            <field name="type">service</field>
            <field name="is_school_fee" eval="True"/>
            <field name="list_price">50000.0</field>
        </record>

        <record id="product_lab_fee" model="product.product">
            <field name="name">Lab Fee</field>
            <field name="default_code">FEE-LAB</field>
            <field name="type">service</field>
            <field name="is_school_fee" eval="True"/>
            <field name="list_price">5000.0</field>
        </record>

        <record id="product_activity_fee" model="product.product">
            <field name="name">Activity Fee</field>
            <field name="default_code">FEE-ACTIVITY</field>
            <field name="type">service</field>
            <field name="is_school_fee" eval="True"/>
            <field name="list_price">2000.0</field>
        </record>

    </data>
</odoo>
