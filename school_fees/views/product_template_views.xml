<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add the is_school_fee flag to the product form (General Information page). -->
    <record id="view_product_template_form_school_fee" model="ir.ui.view">
        <field name="name">product.template.form.school.fee</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="is_school_fee"/>
            </xpath>
        </field>
    </record>

    <!-- Dedicated list for fee items. -->
    <record id="view_product_template_fee_list" model="ir.ui.view">
        <field name="name">product.template.fee.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="default_code"/>
                <field name="name"/>
                <field name="list_price"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_school_fee_items" model="ir.actions.act_window">
        <field name="name">Fee Items</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_school_fee', '=', True)]</field>
        <field name="context">{'default_is_school_fee': True, 'default_type': 'service'}</field>
    </record>

</odoo>
