<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_fee_enrollment_list" model="ir.ui.view">
        <field name="name">school.fee.enrollment.list</field>
        <field name="model">school.fee.enrollment</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='invoiced'"
                  decoration-success="state=='paid'"
                  decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="student_id"/>
                <field name="structure_id"/>
                <field name="classroom_id"/>
                <field name="term_id"/>
                <field name="structure_total" sum="Structure"/>
                <field name="scholarship_total" sum="Scholarship" optional="show"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_due" sum="Due"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_school_fee_enrollment_form" model="ir.ui.view">
        <field name="name">school.fee.enrollment.form</field>
        <field name="model">school.fee.enrollment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_generate_invoice" type="object"
                            string="Generate Invoice"
                            class="oe_highlight"
                            invisible="state not in ('draft', 'confirmed') or invoice_id"/>
                    <button name="action_open_invoice" type="object"
                            string="Open Invoice"
                            invisible="not invoice_id"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancelled',)"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,invoiced,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="classroom_id" readonly="1"/>
                            <field name="structure_id"/>
                            <field name="term_id" readonly="1"/>
                            <field name="academic_year_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="structure_total" readonly="1"/>
                            <field name="scholarship_total" readonly="1"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="amount_paid" readonly="1"/>
                            <field name="amount_due" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="payment_state" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scholarships" name="scholarships">
                            <field name="scholarship_ids"
                                   context="{'default_enrollment_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="discount_type"/>
                                    <field name="discount_amount" optional="hide"/>
                                    <field name="discount_percentage" optional="hide"/>
                                    <field name="computed_amount"/>
                                    <field name="state" widget="badge"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_fee_enrollment_search" model="ir.ui.view">
        <field name="name">school.fee.enrollment.search</field>
        <field name="model">school.fee.enrollment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="structure_id"/>
                <field name="term_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="invoiced" string="Invoiced" domain="[('state','=','invoiced')]"/>
                <filter name="paid" string="Paid" domain="[('state','=','paid')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <group>
                    <filter name="group_term" string="Term" context="{'group_by': 'term_id'}"/>
                    <filter name="group_structure" string="Structure" context="{'group_by': 'structure_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_fee_enrollment" model="ir.actions.act_window">
        <field name="name">Fee Enrollments</field>
        <field name="res_model">school.fee.enrollment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_fee_enrollment_search"/>
    </record>

    <!-- Fee invoices: filter customer invoices linked to a fee enrollment.
         Uses the reverse m2o "school_enrollment_ids" added on account.move. -->
    <record id="action_school_fee_invoices" model="ir.actions.act_window">
        <field name="name">Fee Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('school_enrollment_ids', '!=', False)]</field>
    </record>

</odoo>
