<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_fee_structure_list" model="ir.ui.view">
        <field name="name">school.fee.structure.list</field>
        <field name="model">school.fee.structure</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='open'" decoration-muted="state=='closed'">
                <field name="code"/>
                <field name="name"/>
                <field name="grade_level"/>
                <field name="term_id"/>
                <field name="academic_year_id"/>
                <field name="total_amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_school_fee_structure_form" model="ir.ui.view">
        <field name="name">school.fee.structure.form</field>
        <field name="model">school.fee.structure</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" type="object" string="Open"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'open'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="grade_level"/>
                            <field name="term_id"/>
                            <field name="academic_year_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items" name="items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" readonly="1"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_fee_structure_search" model="ir.ui.view">
        <field name="name">school.fee.structure.search</field>
        <field name="model">school.fee.structure</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="grade_level"/>
                <field name="term_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="open" string="Open" domain="[('state','=','open')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <group>
                    <filter name="group_term" string="Term" context="{'group_by': 'term_id'}"/>
                    <filter name="group_grade" string="Grade" context="{'group_by': 'grade_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_fee_structure" model="ir.actions.act_window">
        <field name="name">Fee Structures</field>
        <field name="res_model">school.fee.structure</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_fee_structure_search"/>
    </record>

</odoo>
