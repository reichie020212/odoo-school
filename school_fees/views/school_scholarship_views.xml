<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_scholarship_list" model="ir.ui.view">
        <field name="name">school.scholarship.list</field>
        <field name="model">school.scholarship</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='applied'" decoration-muted="state=='revoked'">
                <field name="name"/>
                <field name="student_id"/>
                <field name="enrollment_id"/>
                <field name="discount_type"/>
                <field name="discount_amount" optional="show"/>
                <field name="discount_percentage" optional="show"/>
                <field name="computed_amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_school_scholarship_form" model="ir.ui.view">
        <field name="name">school.scholarship.form</field>
        <field name="model">school.scholarship</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply" type="object" string="Apply"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_revoke" type="object" string="Revoke"
                            invisible="state != 'applied'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,applied,revoked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Merit — 10% off"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="enrollment_id"/>
                            <field name="student_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="discount_type"/>
                            <field name="discount_amount"
                                   invisible="discount_type != 'amount'"
                                   required="discount_type == 'amount'"/>
                            <field name="discount_percentage"
                                   invisible="discount_type != 'percentage'"
                                   required="discount_type == 'percentage'"/>
                            <field name="computed_amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Reason">
                        <field name="reason" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_scholarship_search" model="ir.ui.view">
        <field name="name">school.scholarship.search</field>
        <field name="model">school.scholarship</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="enrollment_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="applied" string="Applied" domain="[('state','=','applied')]"/>
                <filter name="revoked" string="Revoked" domain="[('state','=','revoked')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_student" string="Student" context="{'group_by': 'student_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_scholarship" model="ir.actions.act_window">
        <field name="name">Scholarships</field>
        <field name="res_model">school.scholarship</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_scholarship_search"/>
    </record>

</odoo>
