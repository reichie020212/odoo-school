<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="book_hp1" model="school.library.book">
            <field name="title">Harry Potter and the Philosopher's Stone</field>
            <field name="isbn">978-0747532699</field>
            <field name="author_ids" eval="[(6, 0, [ref('author_rowling')])]"/>
            <field name="category_id" ref="category_fiction"/>
            <field name="publisher">Bloomsbury</field>
            <field name="publish_date" eval="'1997-06-26'"/>
            <field name="summary">The first book of the Harry Potter series.</field>
        </record>
        <record id="book_hp1_copy_1" model="school.library.book.copy">
            <field name="book_id" ref="book_hp1"/>
            <field name="barcode">LIB-HP1-01</field>
            <!-- Alice is currently borrowing this copy (see loan demo). -->
            <field name="state">borrowed</field>
        </record>
        <record id="book_hp1_copy_2" model="school.library.book.copy">
            <field name="book_id" ref="book_hp1"/>
            <field name="barcode">LIB-HP1-02</field>
        </record>

        <record id="book_cosmos" model="school.library.book">
            <field name="title">Cosmos</field>
            <field name="isbn">978-0345539434</field>
            <field name="author_ids" eval="[(6, 0, [ref('author_sagan')])]"/>
            <field name="category_id" ref="category_science"/>
            <field name="publisher">Random House</field>
            <field name="publish_date" eval="'1980-01-01'"/>
        </record>
        <record id="book_cosmos_copy_1" model="school.library.book.copy">
            <field name="book_id" ref="book_cosmos"/>
            <field name="barcode">LIB-COS-01</field>
        </record>
        <record id="book_cosmos_copy_2" model="school.library.book.copy">
            <field name="book_id" ref="book_cosmos"/>
            <field name="barcode">LIB-COS-02</field>
        </record>

        <record id="book_peoples_history" model="school.library.book">
            <field name="title">A People's History of the United States</field>
            <field name="isbn">978-0060838652</field>
            <field name="author_ids" eval="[(6, 0, [ref('author_zinn')])]"/>
            <field name="category_id" ref="category_history"/>
            <field name="publisher">Harper Perennial</field>
            <field name="publish_date" eval="'1980-01-01'"/>
        </record>
        <record id="book_peoples_history_copy_1" model="school.library.book.copy">
            <field name="book_id" ref="book_peoples_history"/>
            <field name="barcode">LIB-PHU-01</field>
        </record>
        <record id="book_peoples_history_copy_2" model="school.library.book.copy">
            <field name="book_id" ref="book_peoples_history"/>
            <field name="barcode">LIB-PHU-02</field>
        </record>

    </data>
</odoo>
