<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_library_author_list" model="ir.ui.view">
        <field name="name">school.library.author.list</field>
        <field name="model">school.library.author</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="book_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_school_library_author_form" model="ir.ui.view">
        <field name="name">school.library.author.form</field>
        <field name="model">school.library.author</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="book_count" readonly="1"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group string="Biography">
                        <field name="bio" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_library_author" model="ir.actions.act_window">
        <field name="name">Library Authors</field>
        <field name="res_model">school.library.author</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
