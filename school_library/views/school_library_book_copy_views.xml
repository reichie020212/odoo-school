<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_library_book_copy_list" model="ir.ui.view">
        <field name="name">school.library.book.copy.list</field>
        <field name="model">school.library.book.copy</field>
        <field name="arch" type="xml">
            <list decoration-success="state=='available'"
                  decoration-info="state=='borrowed'"
                  decoration-danger="state=='lost'"
                  decoration-warning="state=='damaged'">
                <field name="barcode"/>
                <field name="book_id"/>
                <field name="state" widget="badge"/>
                <field name="current_loan_id" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_school_library_book_copy_form" model="ir.ui.view">
        <field name="name">school.library.book.copy.form</field>
        <field name="model">school.library.book.copy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="barcode"/>
                            <field name="book_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="current_loan_id" readonly="1"/>
                            <field name="notes"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Loan History" name="history">
                            <field name="loan_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="borrower_id"/>
                                    <field name="borrow_date"/>
                                    <field name="return_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_library_book_copy_search" model="ir.ui.view">
        <field name="name">school.library.book.copy.search</field>
        <field name="model">school.library.book.copy</field>
        <field name="arch" type="xml">
            <search>
                <field name="barcode"/>
                <field name="book_id"/>
                <filter name="available" string="Available" domain="[('state','=','available')]"/>
                <filter name="borrowed" string="Borrowed" domain="[('state','=','borrowed')]"/>
                <filter name="lost" string="Lost" domain="[('state','=','lost')]"/>
                <group>
                    <filter name="group_book" string="Book" context="{'group_by': 'book_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_library_book_copy" model="ir.actions.act_window">
        <field name="name">Book Copies</field>
        <field name="res_model">school.library.book.copy</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_library_book_copy_search"/>
    </record>

</odoo>
