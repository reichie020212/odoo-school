<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_library_book_list" model="ir.ui.view">
        <field name="name">school.library.book.list</field>
        <field name="model">school.library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="title"/>
                <field name="isbn"/>
                <field name="author_ids" widget="many2many_tags"/>
                <field name="category_id"/>
                <field name="publisher" optional="hide"/>
                <field name="copy_count"/>
                <field name="available_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_school_library_book_form" model="ir.ui.view">
        <field name="name">school.library.book.form</field>
        <field name="model">school.library.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title" placeholder="Book title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="isbn"/>
                            <field name="author_ids" widget="many2many_tags"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="publisher"/>
                            <field name="publish_date"/>
                            <field name="copy_count" readonly="1"/>
                            <field name="available_count" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary" name="summary">
                            <field name="summary" nolabel="1"/>
                        </page>
                        <page string="Copies" name="copies">
                            <field name="copy_ids" context="{'default_book_id': id}">
                                <list editable="bottom">
                                    <field name="barcode"/>
                                    <field name="state" widget="badge"/>
                                    <field name="current_loan_id"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_library_book_search" model="ir.ui.view">
        <field name="name">school.library.book.search</field>
        <field name="model">school.library.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="isbn"/>
                <field name="author_ids"/>
                <field name="category_id"/>
                <filter name="has_available" string="Has Available Copies" domain="[('available_count', '>', 0)]"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">school.library.book</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_library_book_search"/>
    </record>

</odoo>
