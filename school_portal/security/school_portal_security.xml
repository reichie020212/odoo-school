<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Portal record rules: a portal user sees only records tied to their
            own partner (as student) or to their wards (as guardian).
            Backend school users/managers continue to see everything via the
            ACLs defined in each upstream module.
        -->

        <record id="school_exam_result_portal_rule" model="ir.rule">
            <field name="name">Exam result: portal user owns it</field>
            <field name="model_id" ref="school_exams.model_school_exam_result"/>
            <field name="domain_force">
                ['|',
                    ('student_id', '=', user.partner_id.id),
                    ('student_id', 'in', user.partner_id.student_ward_ids.ids)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="school_report_card_portal_rule" model="ir.rule">
            <field name="name">Report card: portal user owns it</field>
            <field name="model_id" ref="school_exams.model_school_report_card"/>
            <field name="domain_force">
                ['|',
                    ('student_id', '=', user.partner_id.id),
                    ('student_id', 'in', user.partner_id.student_ward_ids.ids)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="school_report_card_line_portal_rule" model="ir.rule">
            <field name="name">Report card line: portal user owns it</field>
            <field name="model_id" ref="school_exams.model_school_report_card_line"/>
            <field name="domain_force">
                ['|',
                    ('student_id', '=', user.partner_id.id),
                    ('student_id', 'in', user.partner_id.student_ward_ids.ids)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="school_fee_enrollment_portal_rule" model="ir.rule">
            <field name="name">Fee enrollment: portal user owns it</field>
            <field name="model_id" ref="school_fees.model_school_fee_enrollment"/>
            <field name="domain_force">
                ['|',
                    ('student_id', '=', user.partner_id.id),
                    ('student_id', 'in', user.partner_id.student_ward_ids.ids)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

    </data>
</odoo>
