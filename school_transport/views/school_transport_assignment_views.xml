<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_transport_assignment_list" model="ir.ui.view">
        <field name="name">school.transport.assignment.list</field>
        <field name="model">school.transport.assignment</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='active'" decoration-muted="state=='ended'">
                <field name="name"/>
                <field name="student_id"/>
                <field name="route_id"/>
                <field name="pickup_stop_id"/>
                <field name="dropoff_stop_id"/>
                <field name="academic_year_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_school_transport_assignment_form" model="ir.ui.view">
        <field name="name">school.transport.assignment.form</field>
        <field name="model">school.transport.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_end" type="object" string="End"
                            invisible="state != 'active'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,ended"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="route_id"/>
                            <field name="academic_year_id"/>
                        </group>
                        <group>
                            <field name="pickup_stop_id"
                                   domain="[('route_id', '=', route_id)]"/>
                            <field name="dropoff_stop_id"
                                   domain="[('route_id', '=', route_id)]"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_transport_assignment_search" model="ir.ui.view">
        <field name="name">school.transport.assignment.search</field>
        <field name="model">school.transport.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="route_id"/>
                <field name="academic_year_id"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="ended" string="Ended" domain="[('state', '=', 'ended')]"/>
                <group>
                    <filter name="group_route" string="Route" context="{'group_by': 'route_id'}"/>
                    <filter name="group_year" string="Academic Year" context="{'group_by': 'academic_year_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_transport_assignment" model="ir.actions.act_window">
        <field name="name">Transport Assignments</field>
        <field name="res_model">school.transport.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_transport_assignment_search"/>
    </record>

</odoo>
