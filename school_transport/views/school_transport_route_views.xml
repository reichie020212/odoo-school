<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_transport_route_list" model="ir.ui.view">
        <field name="name">school.transport.route.list</field>
        <field name="model">school.transport.route</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='active'" decoration-muted="state=='inactive'">
                <field name="code"/>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="stop_count"/>
                <field name="assignment_count"/>
                <field name="state" widget="badge"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_school_transport_route_form" model="ir.ui.view">
        <field name="name">school.transport.route.form</field>
        <field name="model">school.transport.route</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_deactivate" type="object" string="Deactivate"
                            invisible="state != 'active'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,inactive"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Eastwood Route"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="vehicle_id"/>
                        </group>
                        <group>
                            <field name="stop_count" readonly="1"/>
                            <field name="assignment_count" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stops" name="stops">
                            <field name="stop_ids" context="{'default_route_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="pickup_time" widget="float_time"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Students" name="students">
                            <field name="assignment_ids" readonly="1">
                                <list>
                                    <field name="student_id"/>
                                    <field name="pickup_stop_id"/>
                                    <field name="dropoff_stop_id"/>
                                    <field name="academic_year_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_school_transport_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">school.transport.route</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
