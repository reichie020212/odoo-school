<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_transport_vehicle_list" model="ir.ui.view">
        <field name="name">school.transport.vehicle.list</field>
        <field name="model">school.transport.vehicle</field>
        <field name="arch" type="xml">
            <list decoration-success="state=='active'"
                  decoration-warning="state=='in_repair'"
                  decoration-muted="state=='retired'">
                <field name="plate_number"/>
                <field name="model"/>
                <field name="capacity"/>
                <field name="driver_id"/>
                <field name="state" widget="badge"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_school_transport_vehicle_form" model="ir.ui.view">
        <field name="name">school.transport.vehicle.form</field>
        <field name="model">school.transport.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="plate_number"/>
                            <field name="model"/>
                            <field name="name" readonly="1"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="driver_id"/>
                            <field name="state"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Routes" name="routes">
                            <field name="route_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="stop_count"/>
                                    <field name="assignment_count"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_school_transport_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">school.transport.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
